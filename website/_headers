# Keep the pages.dev copy out of search results; razorcad.com is the real address.
https://razorcad.pages.dev/*
  X-Robots-Tag: noindex
https://:project.razorcad.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/img/*
  Cache-Control: public, max-age=604800
/favicon.*
  Cache-Control: public, max-age=604800
/app/vendor/*
  Cache-Control: public, max-age=86400

# The browser version cross-origin isolated (shared memory), so its geometry kernel can run multi-threaded, as in the
# Windows app
/app/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
